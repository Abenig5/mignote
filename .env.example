DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Email notifications (Resend HTTP API)
# RESEND_API_KEY: create at https://resend.com/api-keys
# EMAIL_FROM: must stay on onboarding@resend.dev until a domain is verified in Resend
# NOTIFICATION_EMAIL: inbox that receives booking and contact inquiries
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Mignote Catering <onboarding@resend.dev>"
NOTIFICATION_EMAIL="your-email@example.com"

# Public site URL
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
